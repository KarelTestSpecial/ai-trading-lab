ignore-scripts=true
save-exact=true
minimum-release-age=7d
# pnpm 11 defaults to erroring on intentionally-ignored build scripts (esbuild);
# keep it a warning so `ignore-scripts=true` stays in force.
strict-dep-builds=false
# Don't implicitly re-run install before every `pnpm run` (keeps CI deterministic).
verify-deps-before-run=false
