# ---- Trading mode & safety gates (MANDATORY) --------------------------------
# Default is paper. Live trading requires ALL THREE gates to be set:
#   TRADING_MODE=live AND ALLOW_LIVE_TRADING=true AND confirm_live=True in code.
TRADING_MODE=paper
ALLOW_LIVE_TRADING=false
# When true, the broker factory refuses live trading unconditionally (public demo).
PUBLIC_DEMO=true

# ---- Alpaca (paper account is free; no KYC required for paper) --------------
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets

# ---- AI judgment layer (Fase 3; Google AI Studio free tier) -----------------
GOOGLE_API_KEY=

# ---- Paper loop -------------------------------------------------------------
# Which experiment arm the daily loop runs, and which judge it uses (rules = offline).
PAPER_ARM=A
PAPER_JUDGE=rules

# ---- Storage ----------------------------------------------------------------
# Committed path: the daily GitHub Action appends decisions here and pushes.
JOURNAL_PATH=journal/decisions.jsonl
